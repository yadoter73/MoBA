--- !u!114 &977914307
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 977914305}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83189876d4d389f43b7dd2e925aa112e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueEditor.NPCConversation
  CurrentIDCounter: 111
  json: "{\"Options\":[],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":102}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":169.833313,\"yPos\":22},\"ID\":101,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You...
    you came back for me. Thank you... I thought the dark out there had taken you
    too.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":true,\"IconGUID\":null,\"Name\":\"Saya\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":103}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":430.5008,\"yPos\":21.3333435},\"ID\":102,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Catch
    your breath for a second... My legs are still shaking after what dragged me toward
    the lake.\",\"parentUIDs\":[101],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":true,\"IconGUID\":null,\"Name\":\"Saya\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":104}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":690.5008,\"yPos\":20.6666718},\"ID\":103,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Look
    around... there is not a scrap of food or clean water left in this house.\",\"parentUIDs\":[102],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Saya\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":105}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":949.1678,\"yPos\":21.3333435},\"ID\":104,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    cannot walk back out into those woods alone... If we stay hungry like this, we
    will not last the night.\",\"parentUIDs\":[103],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Saya\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":106}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1209.83618,\"yPos\":21.3333435},\"ID\":105,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Past
    the fence, down by the lake, there is an old gray building... an abandoned grocery
    store.\",\"parentUIDs\":[104],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Saya\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":107}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1469.16772,\"yPos\":22.0000153},\"ID\":106,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Please,
    go there and bring back whatever food is still untouched \u2014 something to
    keep us going.\",\"parentUIDs\":[105],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Saya\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":108}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1729.834,\"yPos\":21.3333435},\"ID\":107,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wait...
    the iron gate outside is locked. Nobody has used that shop since the mist swallowed
    the road.\",\"parentUIDs\":[106],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Saya\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":109}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1991.16748,\"yPos\":21.3333435},\"ID\":108,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    hid the spare gate key inside the chest of drawers right here in this house.
    Check the drawers carefully.\",\"parentUIDs\":[107],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Saya\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":110}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":2249.83032,\"yPos\":21.3333435},\"ID\":109,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Keep
    your voice down once you step outside. Do not wander near the shore, and do not
    let \\\"them\\\" hear you.\",\"parentUIDs\":[108],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Saya\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":2509.16528,\"yPos\":21.3333435},\"ID\":110,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Find
    the key in the drawer, reach that gray store, and hurry back to me. Please.\",\"parentUIDs\":[109],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Saya\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1}]}"
