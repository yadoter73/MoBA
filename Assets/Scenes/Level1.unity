--- !u!114 &1803294593
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1803294592}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83189876d4d389f43b7dd2e925aa112e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueEditor.NPCConversation
  CurrentIDCounter: 214
  json: "{\"Options\":[],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":202}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":-2960.83325,\"yPos\":232},\"ID\":201,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...Oh.
    A customer... How wonderfully... unexpected.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":203}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-2700.83179,\"yPos\":232},\"ID\":202,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"The
    gate hinges screamed... yet you still stepped inside. Nobody has crossed my threshold
    in... oh, so many winters...\",\"parentUIDs\":[201],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":204}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-2440.16284,\"yPos\":232.666687},\"ID\":203,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Do
    not mind the dust... or the quiet. Tell me, traveler... what brings a living
    voice to my counter?\",\"parentUIDs\":[202],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":205}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-2180.16333,\"yPos\":232},\"ID\":204,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"We're
    trapped in the house across the woods. Saya needs supplies \u2014 vodka, three
    apples, and a loaf of bread.\",\"parentUIDs\":[203],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"You\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":206}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1920.82971,\"yPos\":232},\"ID\":205,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...Vodka.
    Three apples. Bread... Such ordinary, fragile little things for a night like
    this...\",\"parentUIDs\":[204],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":207}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1659.49719,\"yPos\":232},\"ID\":206,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"She
    is waiting for you, isn't she...? Listening at the floorboards... counting every
    breath until the door opens...\",\"parentUIDs\":[205],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":208}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1410.83069,\"yPos\":229.333313},\"ID\":207,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"How
    much do we owe you? I don't have any money left on me.\",\"parentUIDs\":[206],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"You\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":209}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1141.49829,\"yPos\":233.333344},\"ID\":208,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Money...?
    No, no... Paper and copper mean very little when the road outside forgets where
    it leads...\",\"parentUIDs\":[207],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":210}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-880.165161,\"yPos\":232},\"ID\":209,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...Consider
    it free for now... You will pay me another night... with the story of how long
    you both lasted.\",\"parentUIDs\":[208],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":211}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-620.1653,\"yPos\":232},\"ID\":210,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wait
    right there... One bottle of vodka, kept cold behind the counter... Three apples,
    still firm enough to bite...\",\"parentUIDs\":[209],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":212}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-359.500061,\"yPos\":231.333313},\"ID\":211,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...And
    a loaf of bread. Let me set them out on the counter for you...\",\"parentUIDs\":[210],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":213}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-100.166489,\"yPos\":232},\"ID\":212,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Take
    everything from the counter, traveler... Every last piece... Before the mist
    grows curious about us both.\",\"parentUIDs\":[211],\"AdvanceDialogueAutomatically\":true,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.5,\"Volume\":1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":159.833328,\"yPos\":231.333344},\"ID\":213,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...Go
    on back to her now. And do mind the dark... I would hate to lose my favorite
    guest...\",\"parentUIDs\":[212],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Shopkeeper\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":1}]}"
